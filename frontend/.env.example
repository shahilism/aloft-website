# Public URL of the website (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hosted form endpoint that receives enquiries as JSON, e.g. a Formspree form URL
# (https://formspree.io/f/xxxxxxx). When empty, the enquiry form opens the visitor's
# email app with the enquiry pre-filled, addressed to ALOFT.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional: Google Analytics 4 measurement ID. Analytics load only when set.
NEXT_PUBLIC_GA_ID=

# Optional: Google Search Console verification token.
NEXT_PUBLIC_GSC_VERIFICATION=

# Set to true on staging/preview deployments to block search engine indexing.
NEXT_PUBLIC_NOINDEX=false
