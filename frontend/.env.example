# Public URL of the website (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public URL of the NestJS API, used by the browser for enquiry submissions.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: URL the Next.js server uses to reach the API (e.g. an internal Docker hostname).
# Falls back to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Optional: Google Analytics 4 measurement ID. Analytics load only when set.
NEXT_PUBLIC_GA_ID=

# Optional: Google Search Console verification token.
NEXT_PUBLIC_GSC_VERIFICATION=

# Set to true on staging/preview deployments to block search engine indexing.
NEXT_PUBLIC_NOINDEX=false

# Optional: comma-separated HTTPS hosts that serve project photographs.
PROJECT_IMAGE_HOSTS=
