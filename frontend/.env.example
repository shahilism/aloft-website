# Public URL of the website (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hosted form endpoint that receives enquiries as JSON and emails them to ALOFT.
# If this line is removed, it defaults to FormSubmit sending to aloftac@gmail.com.
# Another service (e.g. https://formspree.io/f/xxxxxxx) also works. Set it to empty
# to instead open the visitor's email app with the enquiry pre-filled.
NEXT_PUBLIC_FORM_ENDPOINT=https://formsubmit.co/ajax/aloftac@gmail.com

# Optional: Google Analytics 4 measurement ID. Analytics load only when set.
NEXT_PUBLIC_GA_ID=

# Optional: Google Search Console verification token.
NEXT_PUBLIC_GSC_VERIFICATION=

# Set to true on staging/preview deployments to block search engine indexing.
NEXT_PUBLIC_NOINDEX=false
