# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection (docker compose up -d db gives you this one locally)
DATABASE_URL=postgresql://aloft:aloft@localhost:5432/aloft?schema=public

# Browser origins allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the API (1 behind a typical load balancer)
TRUST_PROXY=0

# Swagger UI at /api/docs
SWAGGER_ENABLED=true

# Local layout preview only — serves the unpublished case-study templates. Keep false in production.
PROJECTS_INCLUDE_DRAFTS=false

# Salt for hashing client IPs on stored enquiries (required, 16+ chars, in production)
IP_HASH_SALT=change-me-to-a-long-random-string

# --- Enquiry protection ----------------------------------------------------
CONTACT_RATE_LIMIT=5
CONTACT_RATE_TTL_SECONDS=600
CONTACT_MIN_FILL_MS=3000

# --- Enquiry notification email (optional) ---------------------------------
# Leave SMTP_HOST empty to store enquiries without sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ALOFT Website <no-reply@aloftac.com>"
ENQUIRY_NOTIFY_TO=aloftac@gmail.com
