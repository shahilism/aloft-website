// ALOFT website database (PostgreSQL).
// Persistence is used for two things only: enquiries submitted through the
// website, and project case studies served by the Projects API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  SPAM
}

model Enquiry {
  id              String        @id @default(uuid()) @db.Uuid
  fullName        String        @db.VarChar(100)
  companyName     String?       @db.VarChar(120)
  email           String        @db.VarChar(254)
  phone           String        @db.VarChar(20)
  projectLocation String        @db.VarChar(120)
  service         String        @db.VarChar(40)
  buildingType    String        @db.VarChar(40)
  approxArea      String?       @db.VarChar(60)
  projectStage    String        @db.VarChar(40)
  message         String        @db.Text
  sourcePath      String?       @db.VarChar(200)
  status          EnquiryStatus @default(NEW)
  /// SHA-256 of the client IP with a server-side salt; the raw IP is never stored.
  ipHash          String?       @db.VarChar(64)
  userAgent       String?       @db.VarChar(300)
  notifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([createdAt])
  @@index([status])
  @@map("enquiries")
}

enum ProjectImageKind {
  COVER
  BEFORE
  AFTER
  GALLERY
}

model Project {
  id               String         @id @default(uuid()) @db.Uuid
  slug             String         @unique @db.VarChar(120)
  title            String         @db.VarChar(160)
  summary          String         @db.Text
  buildingType     String         @db.VarChar(120)
  location         String         @db.VarChar(160)
  system           String         @db.VarChar(160)
  /// Only when verified and approved for publication.
  capacity         String?        @db.VarChar(120)
  scope            String         @db.Text
  servicesProvided String[]
  /// Slugs of related service pages, e.g. "vrf-vrv-systems".
  serviceSlugs     String[]
  challenge        String         @db.Text
  solution         String         @db.Text
  execution        String         @db.Text
  outcome          String         @db.Text
  /// Only published projects are served publicly. Publish only verified, client-approved case studies.
  published        Boolean        @default(false)
  sortOrder        Int            @default(0)
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  images           ProjectImage[]

  @@index([published, sortOrder])
  @@map("projects")
}

model ProjectImage {
  id        String           @id @default(uuid()) @db.Uuid
  projectId String           @db.Uuid
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String           @db.VarChar(500)
  alt       String           @db.VarChar(300)
  kind      ProjectImageKind @default(GALLERY)
  width     Int?
  height    Int?
  sortOrder Int              @default(0)

  @@index([projectId, sortOrder])
  @@map("project_images")
}
